# Generado por scripts/htaccess.mjs — no editar a mano.
# OJO: si alguien ya toco el .htaccess en el servidor, compara antes de subir.

Options -Indexes
DirectoryIndex index.html

<IfModule mod_rewrite.c>
  RewriteEngine On

  # --- forzar https y quitar www ---
  RewriteCond %{HTTPS} !=on
  RewriteRule ^(.*)$ https://%{HTTP_HOST}/$1 [R=301,L]
  RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
  RewriteRule ^(.*)$ https://%1/$1 [R=301,L]

  # --- negociacion de contenido markdown ---
  # Un agente que pide `Accept: text/markdown` recibe el contenido en texto
  # (llms-full.txt: las 9 fichas completas, las 17 preguntas y las condiciones)
  # en vez del HTML. Ningun navegador manda esa cabecera, asi que no afecta a
  # las personas. Es la misma idea que el llms.txt, por la via del protocolo.
  RewriteCond %{HTTP_ACCEPT} text/markdown [NC]
  RewriteRule ^$ /llms-full.txt [L,E=PIDIO_MD:1]

  # --- quitar parametros utm_*: mismo documento, URL distinta ---
  # El enlace de la ficha de Google apunta a
  #   /?utm_source=google&utm_medium=organic&utm_campaign=gbp
  # y Google la indexo como URL aparte. Del 27-sep al 10-oct paso de 0 a 1.401
  # impresiones por semana: el 12,5 % de las atribuidas a paginas, compitiendo
  # con la portada limpia y a veces por delante de ella. El canonical ya
  # apuntaba bien y no basto; un 301 si consolida.
  # No se pierde medicion: `analitica.ga4` esta vacio, ese utm no atribuye nada.
  # Se excluye /gracias/, que recibe los parametros de vuelta de la pasarela.
  RewriteCond %{REQUEST_URI} !^/gracias/
  RewriteCond %{QUERY_STRING} (^|&)utm_[a-z_]+= [NC]
  RewriteRule ^(.*)$ /$1? [R=301,L]

  # --- rutas heredadas de WordPress ---
  RewriteRule ^inicio/?$ / [R=301,L]
  RewriteRule ^shop/?$ /tienda/ [R=301,L]
  RewriteRule ^product/atv\-110/?$ /productos/cuatrimoto-boss-110cc/ [R=301,L]
  RewriteRule ^product/atv\-125/?$ /productos/cuatrimoto-boss-125cc/ [R=301,L]
  RewriteRule ^product/atv\-125cc/?$ /productos/cuatrimoto-boss-125cc/ [R=301,L]
  RewriteRule ^product/atv\-200/?$ /productos/cuatrimoto-boss-200cc/ [R=301,L]
  RewriteRule ^product/atv\-200cc/?$ /productos/cuatrimoto-boss-200cc/ [R=301,L]
  RewriteRule ^product/atv\-200cc\-2/?$ /productos/cuatrimoto-boss-200cc/ [R=301,L]
  RewriteRule ^product/atv\-200cc\-4x2/?$ /productos/cuatrimoto-boss-200cc/ [R=301,L]
  RewriteRule ^product/atv\-250\-titan\-250/?$ /productos/cuatrimoto-titan-250cc/ [R=301,L]
  RewriteRule ^product/atv\-250cc\-4x2/?$ /productos/cuatrimoto-titan-250cc/ [R=301,L]
  RewriteRule ^product/atv\-350cc\-4x4/?$ /productos/cuatrimoto-ranger-350cc/ [R=301,L]
  RewriteRule ^product/arenero\-200/?$ /productos/buggy-arenero-200cc/ [R=301,L]
  RewriteRule ^product/k5\-arenero\-200cc/?$ /productos/buggy-arenero-200cc/ [R=301,L]
  RewriteRule ^product/buggie\-campero\-200/?$ /productos/buggy-campero-200cc/ [R=301,L]
  RewriteRule ^product/carro\-de\-golf/?$ /productos/carro-de-golf-electrico/ [R=301,L]
  RewriteRule ^product/carro\-de\-golf\-2/?$ /productos/carro-de-golf-electrico/ [R=301,L]
  RewriteRule ^product\-category/atv/?$ /cuatrimotos/ [R=301,L]
  RewriteRule ^product\-category/buggie/?$ /buggies/ [R=301,L]
  RewriteRule ^product\-category/arenero/?$ /buggies/ [R=301,L]
  RewriteRule ^product\-category/carros\-golf/?$ /carros-de-golf/ [R=301,L]
  RewriteRule ^product\-category/uncategorized/?$ /tienda/ [R=301,L]
  RewriteRule ^category/uncategorized/?$ /blog/ [R=301,L]
  RewriteRule ^blog/marcas\-de\-cuatrimotos\-en\-colombia/?$ /cuatrimotos/ [R=301,L]
  RewriteRule ^2025/09/15/5\-consejos\-de\-mantenimiento\-para\-alargar\-la\-vida\-de\-tu\-cuatrimoto/?$ /blog/5-consejos-de-mantenimiento-para-alargar-la-vida-de-tu-cuatrimoto/ [R=301,L]
  RewriteRule ^2025/09/15/los\-mejores\-destinos\-en\-colombia\-para\-recorrer\-en\-cuatrimoto/?$ /blog/los-mejores-destinos-en-colombia-para-recorrer-en-cuatrimoto/ [R=301,L]
  RewriteRule ^2025/09/15/que\-tener\-en\-cuenta\-antes\-de\-comprar\-tu\-primera\-cuatrimoto/?$ /blog/que-tener-en-cuenta-antes-de-comprar-tu-primera-cuatrimoto/ [R=301,L]
  RewriteRule ^2025/08/14/hello\-world/?$ /blog/ [R=301,L]
  RewriteRule ^producto/atv\-110/?$ /productos/cuatrimoto-boss-110cc/ [R=301,L]
  RewriteRule ^producto/atv\-125/?$ /productos/cuatrimoto-boss-125cc/ [R=301,L]
  RewriteRule ^producto/atv\-200/?$ /productos/cuatrimoto-boss-200cc/ [R=301,L]
  RewriteRule ^producto/atv\-250\-titan\-250/?$ /productos/cuatrimoto-titan-250cc/ [R=301,L]
  RewriteRule ^producto/arenero\-200/?$ /productos/buggy-arenero-200cc/ [R=301,L]
  RewriteRule ^producto/buggie\-campero\-200/?$ /productos/buggy-campero-200cc/ [R=301,L]
  RewriteRule ^producto/atv\-350cc\-4x4/?$ /productos/cuatrimoto-ranger-350cc/ [R=301,L]
  RewriteRule ^producto/carro\-de\-golf/?$ /productos/carro-de-golf-electrico/ [R=301,L]
  RewriteRule ^cart/?$ /tienda/ [R=301,L]
  RewriteRule ^checkout/?$ /tienda/ [R=301,L]
  RewriteRule ^my\-account/?$ /contacto/ [R=301,L]

  # feeds, buscador y panel de WordPress: ya no existen
  RewriteRule ^feed/?$ / [R=301,L]
  RewriteRule ^wp-admin/?.*$ / [R=301,L]
  RewriteRule ^wp-login\.php$ / [R=301,L]
  RewriteRule ^\?s=.*$ /tienda/ [R=301,L]
</IfModule>

# --- cache: los assets de Astro llevan hash, se pueden cachear para siempre ---
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/webp              "access plus 1 year"
  ExpiresByType image/avif              "access plus 1 year"
  ExpiresByType image/jpeg              "access plus 1 year"
  ExpiresByType image/png               "access plus 1 year"
  ExpiresByType image/svg+xml           "access plus 1 year"
  ExpiresByType text/css                "access plus 1 year"
  ExpiresByType application/javascript  "access plus 1 year"
  ExpiresByType text/html               "access plus 10 minutes"
</IfModule>

<IfModule mod_headers.c>
  # Solo a quien pidio markdown se le declara markdown. Marcar el archivo
  # como text/markdown SIEMPRE haria que el navegador lo descargue en vez de
  # mostrarlo, y nosotros tambien lo abrimos para revisarlo.
  Header set Content-Type "text/markdown; charset=utf-8" env=PIDIO_MD
  <FilesMatch "\.(webp|avif|jpg|jpeg|png|svg|css|js|woff2)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript
  AddOutputFilterByType DEFLATE image/svg+xml application/json
</IfModule>

ErrorDocument 404 /404.html
